<?xml version="1.0" encoding="utf-8"?>
<!--
    Perch publishes its live stream to a media server on the user's own network
    (e.g. http://192.168.1.100:8889/perch/whip). Plain HTTP is allowed because a LAN address
    cannot have a public TLS certificate. Use an https:// address if the server is reachable
    over the internet. Google Drive traffic is always HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
